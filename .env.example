# 微信公众号配置
WX_APP_ID=your-app-id
WX_APP_SECRET=your-app-secret
WX_TOKEN=
# 明文模式可留空；兼容或安全模式请填写公众号后台生成的 EncodingAESKey
WX_AES_KEY=

# 微信 iLink/ClawBot 通道。管理 Token 用于保护扫码登录和状态接口。
ILINK_ENABLED=true
ILINK_ADMIN_TOKEN=change-this-to-a-long-random-token
ILINK_SESSION_FILE=data/ilink-session.json

# 阿里云百炼 DashScope API Key（文本、图片和语音识别共用）
DASHSCOPE_API_KEY=

# 对外访问本服务的根地址；语音回复时用于生成短时有效的 MP3 下载链接
# 示例：https://your-domain.example.com
PUBLIC_BASE_URL=

# Tavily 联网搜索 API Key
TAVILY_API_KEY=
