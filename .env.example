# 微信公众号配置
WX_APP_ID=your-app-id
WX_APP_SECRET=your-app-secret
WX_TOKEN=
# 明文模式可留空；兼容或安全模式请填写公众号后台生成的 EncodingAESKey
WX_AES_KEY=

# 微信 iLink/ClawBot 通道。管理 Token 用于保护扫码登录和状态接口。
ILINK_ENABLED=true
ILINK_ADMIN_TOKEN=change-this-to-a-long-random-token
ILINK_SESSION_FILE=data/ilink-session.json

# 阿里云百炼 DashScope API Key（文本、图片和语音识别共用）
DASHSCOPE_API_KEY=

# 对外访问本服务的根地址；语音回复时用于生成短时有效的 MP3 下载链接
# 示例：https://your-domain.example.com
PUBLIC_BASE_URL=

# Tavily 联网搜索 API Key
TAVILY_API_KEY=

# 团队工具数据目录；待办、账单、提醒按微信用户隔离并持久化
TEAM_TOOLS_DATA_DIR=data/team-tools

# “历史上的今天”数据接口（向 jiangxiaofeng 组员索取）
HISTORY_API_URL=
HISTORY_API_KEY=

# 笑话数据接口（向 jiangxiaofeng 组员索取）
JOKE_API_URL=
JOKE_API_KEY=

# 快递100 企业实时查询（向 anliting 组员索取 customer 与 key）
EXPRESS_API_URL=https://poll.kuaidi100.com/poll/query.do
EXPRESS_CUSTOMER=
EXPRESS_API_KEY=

# 主动提醒扫描间隔；默认每 30 秒检查一次
REMINDER_CHECK_INTERVAL_MS=30000
